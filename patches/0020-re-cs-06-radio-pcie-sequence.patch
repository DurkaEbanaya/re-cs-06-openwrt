++/* RE-CS-06 shares radio initialization resources. Keep PERST asserted until
++ * the integrated radio is ready, with a kernel-owned fail-open deadline.
++ * This local board property is deliberately not a generic Qcom binding.
++ */
++static bool recs06_radio_ready;
++static DEFINE_MUTEX(recs06_gate_lock);
++static struct device *recs06_gate_device;
++
++static void recs06_release_host(struct work_struct *work)
++{
++	struct device *dev;
++	bool timed_out;
++	int ret;
++
++	mutex_lock(&recs06_gate_lock);
++	timed_out = !READ_ONCE(recs06_radio_ready);
++	WRITE_ONCE(recs06_radio_ready, true);
++	dev = recs06_gate_device;
++	recs06_gate_device = NULL;
++	mutex_unlock(&recs06_gate_lock);
++	if (!dev)
++		return;
++	if (timed_out)
++		dev_warn(dev, "AHB readiness timeout; releasing PCIe fail-open\n");
++	else
++		dev_info(dev, "AHB radio ready; releasing PCIe host\n");
++	ret = device_attach(dev);
++	if (ret < 0)
++		dev_warn(dev, "PCIe release probe returned %d\n", ret);
++	put_device(dev);
++}
++static DECLARE_DELAYED_WORK(recs06_release_work, recs06_release_host);
++
++static int recs06_radio_ready_set(const char *val, const struct kernel_param *kp)
++{
++	bool ready;
++	int ret = kstrtobool(val, &ready);
++
++	/* A release cannot be undone on a live bus. */
++	if (ret || !ready)
++		return ret ?: -EINVAL;
++	mutex_lock(&recs06_gate_lock);
++	WRITE_ONCE(recs06_radio_ready, true);
++	if (recs06_gate_device)
++		mod_delayed_work(system_unbound_wq, &recs06_release_work, 0);
++	mutex_unlock(&recs06_gate_lock);
++	return 0;
++}
++
++static const struct kernel_param_ops recs06_ready_ops = {
++	.set = recs06_radio_ready_set,
++	.get = param_get_bool,
++};
++module_param_cb(recs06_radio_ready, &recs06_ready_ops, &recs06_radio_ready, 0644);
++MODULE_PARM_DESC(recs06_radio_ready, "One-way RE-CS-06 AHB-ready PCIe release");
++
+ static int qcom_pcie_probe(struct platform_device *pdev)
+ {
+ 	const struct qcom_pcie_cfg *pcie_cfg;
+@@ -1754,6 +1813,30 @@
