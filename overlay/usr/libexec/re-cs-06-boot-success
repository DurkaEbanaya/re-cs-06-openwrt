#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Match stock's successful-userspace-boot counter handling, not its update policy.
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = jdcloud,re-cs-06 ] || exit 0
[ -r /etc/fw_env.config ] || exit 0
device=$(awk '$1 !~ /^#/ && NF >= 3 { print $1; exit }' /etc/fw_env.config)
[ -b "$device" ] || exit 0
[ "$(cat "/sys/class/block/${device##*/}/size" 2>/dev/null)" = 512 ] || exit 0
grep -qx 'PARTNAME=0:APPSBLENV' "/sys/class/block/${device##*/}/uevent" || exit 0
[ "$(awk '$1 !~ /^#/ && NF >= 3 { print $2, $3; exit }' /etc/fw_env.config)" = '0x0 0x40000' ] || exit 0
counter=$(fw_printenv -c /etc/fw_env.config -n jd_failsafe_counter 2>/dev/null) || exit 0
case "$counter" in
	0) exit 0 ;;
	1|2|3|4|5)
		fw_setenv -c /etc/fw_env.config jd_failsafe_counter 0 || {
			logger -t boot-success 'Could not clear stock boot attempt counter'
			exit 1
		}
		;;
	*) logger -t boot-success 'Unexpected boot attempt counter; leaving it unchanged' ;;
esac
