#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Public defaults: no per-device credentials or identity.
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "jdcloud,re-cs-06" ] || exit 0

uci -q batch <<'EOF'
set network.lan.ipaddr='192.168.76.1'
set network.lan.netmask='255.255.255.0'
set network.wan.auto='0'
set network.wan6.auto='0'
set system.@system[0].hostname='re-cs-06'
set system.@system[0].timezone='UTC'
set system.@system[0].zonename='UTC'
set system.ntp.enable_server='0'
delete system.ntp.server
add_list system.ntp.server='0.openwrt.pool.ntp.org'
add_list system.ntp.server='1.openwrt.pool.ntp.org'
set luci.main.lang='en'
set firewall.@defaults[0].flow_offloading='0'
set firewall.@defaults[0].flow_offloading_hw='0'
set firewall.@defaults[0].fullcone='0'
set firewall.@defaults[0].fullcone6='0'
EOF

# These are custom source/ABI builds, not compatible with official binary feeds.
# Preserve signature verification; disable unverified/incompatible feed URLs.
if [ -f /etc/opkg/distfeeds.conf ]; then
	sed -i '/^src\/gz /s/^/# Disabled for custom build: /' /etc/opkg/distfeeds.conf
fi
exit 0
