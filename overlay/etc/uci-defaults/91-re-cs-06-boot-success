#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Install a board-scoped successful-userspace-boot counter hook. No boot slot
# selection is changed. fw_env.config is generated by platform defaults first.
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = jdcloud,re-cs-06 ] || exit 0

hook=/usr/libexec/re-cs-06-boot-success
[ -x "$hook" ] || exit 1
# Preserve owner rc.local content and avoid duplicate calls on retained config.
if ! grep -q '^/usr/libexec/re-cs-06-boot-success$' /etc/rc.local; then
	grep -qx 'exit 0' /etc/rc.local || exit 1
	sed -i '/^exit 0/i /usr/libexec/re-cs-06-boot-success' /etc/rc.local || exit 1
fi
exit 0
