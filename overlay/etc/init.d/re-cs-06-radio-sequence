#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=94
STOP=10
USE_PROCD=1

start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = jdcloud,re-cs-06 ] || return 0
	[ -w /sys/module/pcie_qcom/parameters/recs06_radio_ready ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/re-cs-06-radio-ready
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance reconcile
	procd_set_param command /usr/libexec/re-cs-06-radio-reconcile
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
