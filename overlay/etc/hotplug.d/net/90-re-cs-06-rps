#!/bin/sh
# Keep PPE RX protocol work off the CPU handling its interrupt/NAPI path.
# Validated together with the socket-stable TX queue patch; not CPU pinning
# of applications, and not a change to Wi-Fi or other boards/interfaces.
[ "$ACTION" = add ] || exit 0
[ "$DEVICENAME" = switch ] || exit 0
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = jdcloud,re-cs-06 ] || exit 0
[ "$(uci -q get 'network.@globals[0].packet_steering' 2>/dev/null)" != 0 ] || exit 0
[ -d /sys/devices/system/cpu/cpu1 ] || exit 0
# With CONFIG_HOTPLUG_CPU=n the per-CPU online attribute does not exist;
# an enumerated secondary CPU cannot then be taken offline by userspace.
if [ -e /sys/devices/system/cpu/cpu1/online ]; then
	[ "$(cat /sys/devices/system/cpu/cpu1/online)" = 1 ] || exit 0
fi
for queue in /sys/class/net/switch/queues/rx-*/rps_cpus; do
	[ -w "$queue" ] || continue
	printf '%s\n' 2 > "$queue" || exit 1
done
