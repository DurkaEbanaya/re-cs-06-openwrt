CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_sms-tool=y
CONFIG_PACKAGE_coreutils-stty=y
CONFIG_PACKAGE_usb-modeswitch=y
# Optional userspace: build signed packages without enabling a competing
# ModemManager connection owner on every existing QMI installation.
CONFIG_PACKAGE_modemmanager=m
CONFIG_PACKAGE_qmi-utils=m
CONFIG_PACKAGE_mbim-utils=m
CONFIG_PACKAGE_luci-proto-modemmanager=m
CONFIG_PACKAGE_adb=m
# Optional capabilities are built for this kernel, NOT installed or activated
# in the base image. Keep the release ABI fixed after publishing these modules.
CONFIG_PACKAGE_kmod-ifb=m
CONFIG_PACKAGE_kmod-sched-core=m
CONFIG_PACKAGE_kmod-sched-cake=m
CONFIG_PACKAGE_tc-full=m
CONFIG_PACKAGE_sqm-scripts=m
CONFIG_PACKAGE_luci-app-sqm=m
CONFIG_PACKAGE_kmod-ipvlan=m
CONFIG_PACKAGE_kmod-dummy=m
CONFIG_PACKAGE_kmod-br-netfilter=m
CONFIG_PACKAGE_kmod-gre=m
CONFIG_PACKAGE_kmod-gre6=m
CONFIG_PACKAGE_kmod-vxlan=m
CONFIG_PACKAGE_kmod-ipip=m
CONFIG_PACKAGE_kmod-sit=m
CONFIG_PACKAGE_kmod-fs-exfat=m
CONFIG_PACKAGE_kmod-fs-vfat=m
CONFIG_PACKAGE_kmod-fs-ntfs3=m
CONFIG_PACKAGE_kmod-nls-cp437=m
CONFIG_PACKAGE_kmod-nls-iso8859-1=m
CONFIG_PACKAGE_kmod-nls-utf8=m
CONFIG_PACKAGE_ca-bundle=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="RE-CS-06-Minimal-LEDE"
CONFIG_VERSION_NUMBER="experimental-2026.11.11-package-support-r19-external"
CONFIG_VERSION_HOME_URL="https://github.com/DurkaEbanaya/re-cs-06-openwrt"
CONFIG_VERSION_BUG_URL="https://github.com/DurkaEbanaya/re-cs-06-openwrt/issues"
