CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
CONFIG_TARGET_qualcommbe_ipq53xx_DEVICE_jdcloud_re-cs-06=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_KERNEL_DEBUG_INFO_BTF is not set
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_LUCI_LANG_en=y
CONFIG_LUCI_LANG_ru=y
# CONFIG_LUCI_LANG_zh_Hans is not set
# CONFIG_LUCI_LANG_zh-cn is not set
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_kmod-dsa-qca8k=y
CONFIG_PACKAGE_kmod-phy-qca83xx=y
CONFIG_PACKAGE_kmod-pcs-qcom-ipq9574=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="RE-CS-06-Minimal-LEDE"
CONFIG_VERSION_NUMBER="experimental-2026.11.02"
CONFIG_VERSION_HOME_URL="https://github.com/DurkaEbanaya/re-cs-06-openwrt"
CONFIG_VERSION_BUG_URL="https://github.com/DurkaEbanaya/re-cs-06-openwrt/issues"
